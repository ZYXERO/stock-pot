# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres: Connect -> Session pooler string, with your password
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# OpenAI: embeddings (comparison), chat (baseline + live demo), dish images
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Self-hosted embedding model (sentence-transformers, runs on CPU)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local LLMs served by Ollama (Phase 4)
OLLAMA_BASE_URL=http://localhost:11434

# Which model generates recipes: openai | ollama:llama3.1 | ollama:mistral | ollama:stockpot-llama | ollama:stockpot-mistral
GENERATION_MODEL=openai

# Pantry staples a generated recipe may use even if the user didn't list them
STAPLES=salt,pepper,oil,water,butter,sugar,flour

# Frontend (Phase 7)
NEXT_PUBLIC_API_URL=http://localhost:8000